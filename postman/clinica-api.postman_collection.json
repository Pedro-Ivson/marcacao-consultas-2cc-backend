{
  "info": {
    "name": "Clínica API - Aula 08/10/2026",
    "description": "Fluxo da aula para conferir os GETs, criar consulta e validar respostas 400/404. Não usa Authorization nem JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const formatDate = (date) => [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-');",
          "const today = new Date();",
          "const future = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 10);",
          "const outsideWindow = new Date(today.getFullYear(), today.getMonth() + 3, today.getDate());",
          "pm.collectionVariables.set('dataHoje', formatDate(today));",
          "pm.collectionVariables.set('dataFutura', formatDate(future));",
          "pm.collectionVariables.set('dataForaJanela', formatDate(outsideWindow));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "GET /clinica",
      "request": { "method": "GET", "url": "{{baseUrl}}/clinica" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 e serviço no ar', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().ok).to.eql(true); });"] } }]
    },
    {
      "name": "GET /especialidades",
      "request": { "method": "GET", "url": "{{baseUrl}}/especialidades" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 e dez especialidades', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.length(10); });"] } }]
    },
    {
      "name": "GET /medicos",
      "request": { "method": "GET", "url": "{{baseUrl}}/medicos" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200, dez médicos e especialidade aninhada', () => { const body = pm.response.json(); pm.response.to.have.status(200); pm.expect(body).to.have.length(10); pm.expect(body[0].especialidade.nome).to.eql('Cardiologia'); });"] } }]
    },
    {
      "name": "GET /usuarios (sem senha)",
      "request": { "method": "GET", "url": "{{baseUrl}}/usuarios" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200, doze contas e nenhuma senha', () => { const body = pm.response.json(); pm.response.to.have.status(200); pm.expect(body).to.have.length(12); pm.expect(body.every((usuario) => !('senha' in usuario))).to.eql(true); });"] } }]
    },
    {
      "name": "GET /consultas",
      "request": { "method": "GET", "url": "{{baseUrl}}/consultas" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 e uma lista JSON', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"] } }]
    },
    {
      "name": "GET /consultas/999 (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/consultas/999" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404 para consulta inexistente', () => { pm.response.to.have.status(404); });"] } }]
    },
    {
      "name": "POST /consultas (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"medicoId\": 1,\n  \"pacienteId\": 1,\n  \"data\": \"{{dataFutura}}\",\n  \"observacoes\": \"Retorno via API\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/consultas"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 e consulta criada para Maria e Ana', () => { const body = pm.response.json(); pm.response.to.have.status(201); pm.expect(body.medico.nome).to.eql('Dra. Ana Souza'); pm.expect(body.paciente.nome).to.eql('Maria Silva'); pm.expect(body.valor).to.eql(350); pm.expect(body.status).to.eql('agendada'); pm.collectionVariables.set('consultaId', body.id); });"] } }]
    },
    {
      "name": "GET /consultas/{{consultaId}}",
      "request": { "method": "GET", "url": "{{baseUrl}}/consultas/{{consultaId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 para consulta criada', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('consultaId'))); });"] } }]
    },
    {
      "name": "POST /consultas com data de hoje (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"medicoId\": 1,\n  \"pacienteId\": 1,\n  \"data\": \"{{dataHoje}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/consultas"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 para data de hoje', () => { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "POST /consultas além de dois meses (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"medicoId\": 1,\n  \"pacienteId\": 1,\n  \"data\": \"{{dataForaJanela}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/consultas"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 para data além da janela', () => { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "POST /consultas com médico inexistente (404)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"medicoId\": 999,\n  \"pacienteId\": 1,\n  \"data\": \"{{dataFutura}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/consultas"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404 para médico inexistente', () => { pm.response.to.have.status(404); });"] } }]
    },
    {
      "name": "POST /consultas sem body (400)",
      "request": { "method": "POST", "url": "{{baseUrl}}/consultas" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 quando o body está ausente', () => { pm.response.to.have.status(400); });"] } }]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "consultaId", "value": "1" },
    { "key": "dataHoje", "value": "" },
    { "key": "dataFutura", "value": "" },
    { "key": "dataForaJanela", "value": "" }
  ]
}
